# ── Python bytecode ─────────────────────────────────────────────────────────
__pycache__/
*.py[cod]

# ── Python packaging artifacts ───────────────────────────────────────────────
.Python
*.egg-info/
dist/
build/
*.egg

# ── Virtual environments ─────────────────────────────────────────────────────
.venv/
venv/
env/

# ── Test / coverage ──────────────────────────────────────────────────────────
.pytest_cache/
.coverage
htmlcov/

# ── CAPRLM security-sensitive artifacts ─────────────────────────────────────

# Trained model files — may contain learned patterns from private screenshots
*.joblib

# Per-user profiles — may indirectly reveal screenshot content via feedback
Member2/backend/data/profiles/

# Training log — contains label distributions derived from private screenshots
Member2/backend/data/training_log.json

# ── Research dataset — keep the annotation CSV, exclude raw screenshot data ──
# CAPRLM_annotation_50.csv is intentionally tracked; do not add rules that
# would cause it to be ignored.
Member2/backend/data/screenshots/
*.jpg
*.jpeg
*.png
*.bmp
*.tiff
*.tif

# ── Pipeline output and pilot directories — generated, not source ─────────────
Member2/backend/data/pilot_10/
Member2/backend/data/pilot_flush_opt/
Member2/backend/data/processing_output/
Member2/backend/data/processing_output_optimized_test/
Member2/backend/data/resize_eval/
Member2/backend/data/timeout_pilot/

# ── Timestamped backup scripts created by the optimization workflow ───────────
Member2/backend/scripts/process_screenshots_backup.py
Member2/backend/scripts/process_screenshots_pre_*.py
Member2/backend/scripts/process_screenshots_pre_optimization.py

# ── Standalone benchmark/investigation scripts (not production code) ──────────
Member2/backend/scripts/benchmark_ocr.py
Member2/backend/scripts/benchmark_resize.py

# ── IDE ──────────────────────────────────────────────────────────────────────
.vscode/
.idea/
*.suo
*.user

# ── OS ───────────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

