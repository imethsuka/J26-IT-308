<UserControl x:Class="ContextDashboard.Views.ModelsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:v="clr-namespace:ContextDashboard.Views"
             FontFamily="Segoe UI" FontSize="13" Foreground="{StaticResource Ink}">
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="32,24,32,24">
      <DockPanel Margin="0,0,0,16">
        <v:CaptureBar DockPanel.Dock="Right" VerticalAlignment="Top" />
        <StackPanel>
          <TextBlock Text="Models" Style="{StaticResource PageTitle}" />
          <TextBlock Text="Deployed and earlier versions of Model 1. Versions are append-only." Style="{StaticResource MutedText}" Margin="0,2,0,0" />
        </StackPanel>
      </DockPanel>

      <!-- A new model is active but the worker still runs the old one -->
      <Border Background="#FBF1D8" BorderBrush="#E8C46A" BorderThickness="1" CornerRadius="10" Padding="14,10" Margin="0,0,0,14">
        <Border.Style>
          <Style TargetType="Border">
            <Setter Property="Visibility" Value="Visible" />
            <Style.Triggers>
              <DataTrigger Binding="{Binding RestartText}" Value="">
                <Setter Property="Visibility" Value="Collapsed" />
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </Border.Style>
        <DockPanel>
          <Button DockPanel.Dock="Right" Content="Restart capture" Click="OnRestart" Margin="12,0,0,0" />
          <TextBlock Text="{Binding RestartText}" TextWrapping="Wrap" VerticalAlignment="Center" />
        </DockPanel>
      </Border>

      <Border Style="{StaticResource Card}">
        <StackPanel>
          <TextBlock Text="Learning (Model 2)" Style="{StaticResource CardTitle}" />
          <TextBlock Style="{StaticResource MutedText}" Margin="0,3,0,12"
                     Text="Labels old records from what you did afterwards, learns your habits, retrains Model 1 and deploys it only if it is strictly better than the current one. A copy of the database is made before every run." />
          <StackPanel Orientation="Horizontal">
            <Button Content="Run learning now" Click="OnRunLearning" IsEnabled="{Binding LearningIdle}" />
            <CheckBox Content="Quick test (1-hour window)" IsChecked="{Binding QuickTest, Mode=TwoWay}" VerticalAlignment="Center" Margin="14,0,14,0"
                      ToolTip="Labels records after 1 hour instead of 48. Labels are noisier: use it to try the pipeline, not for results." />
            <CheckBox Content="Keep-Worthiness labels" IsChecked="{Binding UseKw, Mode=TwoWay}" VerticalAlignment="Center" />
          </StackPanel>
          <TextBlock Text="{Binding LearningStatus}" Foreground="{StaticResource Amber}" Margin="0,10,0,0" TextWrapping="Wrap" />
          <TextBlock Text="{Binding LearningText}" Margin="0,8,0,0" TextWrapping="Wrap" />
          <TextBlock Text="{Binding LearnerText}" Style="{StaticResource MutedText}" Margin="0,4,0,0" />
        </StackPanel>
      </Border>

      <Border Style="{StaticResource Card}" Padding="4">
        <DataGrid Style="{StaticResource WarmGrid}" ItemsSource="{Binding Models}" BorderThickness="0" MinHeight="120">
          <DataGrid.Columns>
            <DataGridCheckBoxColumn Header="Active" Binding="{Binding IsActive, Mode=OneWay}" Width="64" />
            <DataGridTextColumn Header="Version" Binding="{Binding Version}" Width="210" />
            <DataGridTextColumn Header="Algorithm" Binding="{Binding Algorithm}" Width="110" />
            <DataGridTextColumn Header="Created" Binding="{Binding Created, StringFormat=dd MMM yyyy HH:mm}" Width="140" />
            <DataGridTextColumn Header="Metrics" Binding="{Binding Metrics}" Width="*" />
          </DataGrid.Columns>
        </DataGrid>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
