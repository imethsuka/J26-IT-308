<UserControl x:Class="ContextDashboard.Views.ScreenTextPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:v="clr-namespace:ContextDashboard.Views"
             FontFamily="Segoe UI" FontSize="13" Foreground="{StaticResource Ink}">
  <UserControl.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVisible" />
  </UserControl.Resources>
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="32,24,32,24">
      <DockPanel Margin="0,0,0,16">
        <v:CaptureBar DockPanel.Dock="Right" VerticalAlignment="Top" />
        <StackPanel>
          <TextBlock Text="Screen text" Style="{StaticResource PageTitle}" />
          <TextBlock Text="Opt-in. Off until you turn it on, and it never leaves this PC." Style="{StaticResource MutedText}" Margin="0,2,0,0" />
        </StackPanel>
      </DockPanel>

      <Border Style="{StaticResource Card}">
        <StackPanel>
          <TextBlock Text="Capture" Style="{StaticResource CardTitle}" />
          <TextBlock Style="{StaticResource MutedText}" Margin="0,3,0,10"
                     Text="Reads the words visible in the window you are using, so the system can build memory entries about what you read and did." />
          <CheckBox x:Name="ScreenTextBox" Content="Capture screen text (off by default)"
                    IsChecked="{Binding ScreenTextActive, Mode=OneWay}" Click="OnScreenTextClicked" />
          <TextBlock Text="{Binding ScreenStateText}" Margin="26,4,0,0" TextWrapping="Wrap" />
          <TextBlock Text="{Binding FilterText}" Foreground="{StaticResource Amber}" Margin="26,4,0,0" TextWrapping="Wrap" />
          <CheckBox x:Name="KeepUnredactedBox" Margin="26,10,0,0" Click="OnKeepUnredactedClicked"
                    Content="Developer: keep the text without a privacy filter (nothing is redacted)"
                    IsChecked="{Binding KeepUnredacted, Mode=OneWay}"
                    Visibility="{Binding ScreenTextActive, Converter={StaticResource BoolToVisible}}" />
          <TextBlock Text="{Binding ScreenStatus}" Foreground="{StaticResource Amber}" Margin="0,10,0,0" TextWrapping="Wrap" />
        </StackPanel>
      </Border>

      <Border Style="{StaticResource Card}">
        <DockPanel>
          <Button DockPanel.Dock="Right" Content="Delete all captured text" Click="OnDeleteScreenText"
                  IsEnabled="{Binding ScreenIdle}" Margin="12,0,0,0" VerticalAlignment="Center" />
          <StackPanel>
            <TextBlock Text="{Binding RawBufferText}" TextWrapping="Wrap" />
            <TextBlock Text="{Binding MemoryStatsText}" Foreground="{StaticResource Muted}" Margin="0,4,0,0" TextWrapping="Wrap" />
            <TextBlock Style="{StaticResource MutedText}" Margin="0,4,0,0"
                       Text="This view shows counts and sizes only. The captured text itself is encrypted and is not shown here." />
          </StackPanel>
        </DockPanel>
      </Border>

      <TextBlock Style="{StaticResource MutedText}" Margin="2,0,0,8"
                 Text="Memory entries, newest first. Each is one stretch in one page; coming back later counts as another visit." />
      <Border Style="{StaticResource Card}" Padding="4">
        <DataGrid Style="{StaticResource WarmGrid}" ItemsSource="{Binding MemoryEntries}" BorderThickness="0" MinHeight="140">
          <DataGrid.Columns>
            <DataGridTextColumn Header="When" Binding="{Binding Start, StringFormat=dd MMM HH:mm}" Width="100" />
            <DataGridTextColumn Header="App" Binding="{Binding App}" Width="110" />
            <DataGridTextColumn Header="Site" Binding="{Binding Site}" Width="140" />
            <DataGridTextColumn Header="Page" Binding="{Binding Title}" Width="*" />
            <DataGridTextColumn Header="Visit" Binding="{Binding Visit}" Width="50" />
            <DataGridTextColumn Header="Tier" Binding="{Binding Tier}" Width="70" />
            <DataGridTextColumn Header="Importance" Binding="{Binding Importance}" Width="90" />
            <DataGridCheckBoxColumn Header="Text kept" Binding="{Binding TextKept, Mode=OneWay}" Width="80" />
          </DataGrid.Columns>
        </DataGrid>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
