<UserControl x:Class="ContextDashboard.Views.HistoryPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:v="clr-namespace:ContextDashboard.Views"
             FontFamily="Segoe UI" FontSize="13" Foreground="{StaticResource Ink}"
             PreviewKeyDown="OnKey">
  <DockPanel Margin="32,24,32,20">
    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
      <v:CaptureBar DockPanel.Dock="Right" VerticalAlignment="Top" />
      <StackPanel>
        <TextBlock Text="History" Style="{StaticResource PageTitle}" />
        <TextBlock Text="Scroll back through your day: what was on screen, and the page you were reading at that moment."
                   Style="{StaticResource MutedText}" Margin="0,2,0,0" />
      </StackPanel>
    </DockPanel>

    <!-- Day and screenshot controls -->
    <Border DockPanel.Dock="Top" Style="{StaticResource Card}" Padding="14,10" Margin="0,0,0,12">
      <DockPanel>
        <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
          <Button Content="&#x2039;" Click="OnPrevDay" Width="32" ToolTip="Previous day with activity" />
          <DatePicker x:Name="DayPicker" SelectedDateChanged="OnDayPicked" Margin="6,0" Width="150" />
          <Button Content="&#x203A;" Click="OnNextDay" Width="32" ToolTip="Next day with activity" />
          <Button Content="Today" Click="OnToday" Margin="6,0,0,0" />
        </StackPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
          <CheckBox x:Name="ShotsBox" Content="Keep screenshots" Click="OnShotsClicked" VerticalAlignment="Center" />
          <Button Content="Delete all screenshots" Click="OnDeleteShots" Margin="12,0,0,0" />
        </StackPanel>
        <TextBlock x:Name="DayText" Style="{StaticResource MutedText}" VerticalAlignment="Center" Margin="16,0"
                   TextTrimming="CharacterEllipsis" />
      </DockPanel>
    </Border>

    <!-- The slider -->
    <Border DockPanel.Dock="Bottom" Style="{StaticResource Card}" Padding="16,12" Margin="0,12,0,0">
      <StackPanel>
        <DockPanel>
          <TextBlock x:Name="StartLabel" DockPanel.Dock="Left" Style="{StaticResource MonoText}" Foreground="{StaticResource Muted}" />
          <TextBlock x:Name="EndLabel" DockPanel.Dock="Right" Style="{StaticResource MonoText}" Foreground="{StaticResource Muted}" />
          <TextBlock x:Name="NowLabel" HorizontalAlignment="Center" FontSize="15" FontWeight="SemiBold" />
        </DockPanel>
        <!-- One coloured band per app, in time; it lines up with the slider track below. -->
        <Canvas x:Name="Strip" Height="8" Margin="6,8,6,0" ClipToBounds="True" SizeChanged="OnStripResized" />
        <Slider x:Name="TimeSlider" ValueChanged="OnSliderMoved" IsMoveToPointEnabled="True" Margin="0,2,0,0" />
        <TextBlock Style="{StaticResource MutedText}" FontSize="11"
                   Text="Drag the slider, or use &#x2190; &#x2192; for the previous or next moment and Page Up / Page Down to jump 10 minutes." />
      </StackPanel>
    </Border>
    <TextBlock x:Name="StatusText" DockPanel.Dock="Bottom" Foreground="{StaticResource Amber}" TextWrapping="Wrap" Margin="2,8,0,0" />

    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="3*" />
        <ColumnDefinition Width="16" />
        <ColumnDefinition Width="2*" MinWidth="260" />
      </Grid.ColumnDefinitions>

      <!-- What was on screen -->
      <Border Style="{StaticResource Card}" Margin="0" Padding="8">
        <Grid>
          <Image x:Name="ShotImage" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" />
          <TextBlock x:Name="ShotPlaceholder" Style="{StaticResource MutedText}" TextWrapping="Wrap" TextAlignment="Center"
                     VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="380" />
          <Border x:Name="ShotBadge" Background="#B31F2421" CornerRadius="6" Padding="8,3" Margin="8"
                  HorizontalAlignment="Right" VerticalAlignment="Bottom" Visibility="Collapsed">
            <TextBlock x:Name="ShotTime" Foreground="White" FontFamily="Consolas" FontSize="11" />
          </Border>
        </Grid>
      </Border>

      <!-- The page that was open -->
      <Border Grid.Column="2" Style="{StaticResource Card}" Margin="0">
        <DockPanel>
          <StackPanel DockPanel.Dock="Top">
            <TextBlock x:Name="WhenText" Style="{StaticResource MonoText}" Foreground="{StaticResource Muted}" />
            <TextBlock x:Name="TitleText" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,4,0,2" />
            <TextBlock x:Name="WhereText" Style="{StaticResource MutedText}" TextTrimming="CharacterEllipsis" />
            <TextBlock x:Name="TextNote" Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,8,0,0" />
          </StackPanel>
          <FlowDocumentScrollViewer x:Name="PageView" Margin="0,10,0,0" VerticalScrollBarVisibility="Auto"
                                    IsToolBarVisible="False" />
        </DockPanel>
      </Border>
    </Grid>
  </DockPanel>
</UserControl>
