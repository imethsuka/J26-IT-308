<UserControl x:Class="ContextDashboard.Views.LiveFeedPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:v="clr-namespace:ContextDashboard.Views"
             FontFamily="Segoe UI" FontSize="13" Foreground="{StaticResource Ink}">
  <DockPanel Margin="32,24,32,24">
    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,16">
      <v:CaptureBar DockPanel.Dock="Right" VerticalAlignment="Top" />
      <StackPanel>
        <TextBlock Text="Live feed" Style="{StaticResource PageTitle}" />
        <TextBlock Text="Newest 300 records. Titles come from your local database and never leave this PC."
                   Style="{StaticResource MutedText}" Margin="0,2,0,0" />
      </StackPanel>
    </DockPanel>
    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,10">
      <TextBox x:Name="FilterBox" Width="280" ToolTip="Filter by app, domain or title" TextChanged="OnFilterChanged" />
      <ComboBox x:Name="DecisionBox" Width="120" Margin="8,0,0,0" SelectedIndex="0" SelectionChanged="OnFilterChanged">
        <ComboBoxItem Content="all" />
        <ComboBoxItem Content="save" />
        <ComboBoxItem Content="discard" />
      </ComboBox>
    </StackPanel>
    <Border Style="{StaticResource Card}" Padding="4" Margin="0">
      <DataGrid Style="{StaticResource WarmGrid}" ItemsSource="{Binding Recent}" BorderThickness="0">
        <DataGrid.Columns>
          <DataGridTextColumn Header="Time" Binding="{Binding Time, StringFormat=HH:mm:ss dd MMM}" Width="130" />
          <DataGridTextColumn Header="App" Binding="{Binding App}" Width="130" />
          <DataGridTextColumn Header="Domain" Binding="{Binding Domain}" Width="160" />
          <DataGridTextColumn Header="Title" Binding="{Binding Title}" Width="*" />
          <DataGridTextColumn Header="Decision" Binding="{Binding Decision}" Width="80" />
          <DataGridTextColumn Header="DRC" Binding="{Binding Drc}" Width="70" />
        </DataGrid.Columns>
      </DataGrid>
    </Border>
  </DockPanel>
</UserControl>
