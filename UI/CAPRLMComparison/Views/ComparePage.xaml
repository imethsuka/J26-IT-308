<UserControl x:Class="CAPRLMComparison.Views.ComparePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             FontFamily="Segoe UI" FontSize="13">
  <Grid Margin="12">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <!-- Input -->
    <Border Grid.Row="0" Background="White" BorderBrush="#E1E5EA" BorderThickness="1" CornerRadius="8" Padding="16">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="20" />
          <ColumnDefinition Width="300" />
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0">
          <TextBlock Text="Text to filter" FontWeight="SemiBold" Margin="0,0,0,6" />
          <TextBox x:Name="InputText" AcceptsReturn="True" TextWrapping="Wrap" Height="120"
                   VerticalScrollBarVisibility="Auto"
                   Text="Contact john.doe@example.com or call 077-123-4567 about the invoice. Balance due: $4,500." />
          <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
            <Button x:Name="PickImageButton" Content="Choose screenshot…" Click="OnPickImage" />
            <Button x:Name="ClearImageButton" Content="Clear" Click="OnClearImage" Margin="8,0,0,0" Visibility="Collapsed" />
            <TextBlock x:Name="ImageLabel" VerticalAlignment="Center" Margin="12,0,0,0" Foreground="#6B7580"
                       Text="No screenshot — the text box is used (source: UI Automation)." />
          </StackPanel>
        </StackPanel>

        <Grid Grid.Column="2">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>

          <TextBlock Grid.Row="0" Text="App" VerticalAlignment="Center" Margin="0,0,12,8" />
          <TextBox Grid.Row="0" Grid.Column="1" x:Name="AppBox" Text="chrome" Margin="0,0,0,8" />
          <TextBlock Grid.Row="1" Text="Domain" VerticalAlignment="Center" Margin="0,0,12,8" />
          <TextBox Grid.Row="1" Grid.Column="1" x:Name="DomainBox" Text="secure.examplebank.com" Margin="0,0,0,8" />
          <TextBlock Grid.Row="2" Text="Title" VerticalAlignment="Center" Margin="0,0,12,8" />
          <TextBox Grid.Row="2" Grid.Column="1" x:Name="TitleBox" Text="Account Summary" Margin="0,0,0,8" />
          <TextBlock Grid.Row="3" Text="Source" VerticalAlignment="Center" Margin="0,0,12,8" />
          <ComboBox Grid.Row="3" Grid.Column="1" x:Name="SourceBox" SelectedIndex="0" Margin="0,0,0,8" HorizontalAlignment="Stretch">
            <ComboBoxItem Content="uia" />
            <ComboBoxItem Content="ocr" />
          </ComboBox>
          <ui:Button Grid.Row="4" Grid.ColumnSpan="2" x:Name="CompareButton" Content="Compare" Click="OnCompare"
                     HorizontalAlignment="Stretch" Margin="0,6,0,0" Appearance="Primary" />
        </Grid>
      </Grid>
    </Border>

    <!-- Status / error: always says what happened; never blank. -->
    <Border Grid.Row="1" x:Name="StatusBanner" Margin="0,12,0,0" CornerRadius="6" Padding="12,8" Visibility="Collapsed">
      <TextBlock x:Name="StatusText" TextWrapping="Wrap" />
    </Border>

    <!-- Results: five cards side by side. -->
    <ScrollViewer Grid.Row="2" Margin="0,12,0,0" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
      <StackPanel>
        <ItemsControl x:Name="Cards">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <StackPanel Orientation="Horizontal" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border Width="320" Margin="0,0,12,0" Padding="14" Background="White" CornerRadius="8"
                      BorderThickness="{Binding BorderThickness}" BorderBrush="{Binding BorderBrush}">
                <StackPanel>
                  <TextBlock Text="{Binding Title}" FontSize="16" FontWeight="SemiBold" />
                  <TextBlock Text="{Binding FilterVersion}" Foreground="#6B7580" FontSize="11" Margin="0,2,0,10" />

                  <Border Visibility="{Binding BlockedVisibility}" Background="#FDECEA" CornerRadius="4" Padding="8,4" Margin="0,0,0,8">
                    <TextBlock Text="BLOCKED — content must not be stored" Foreground="#B3261E" FontWeight="SemiBold" TextWrapping="Wrap" />
                  </Border>
                  <TextBlock Visibility="{Binding ErrorVisibility}" Text="{Binding Error}" Foreground="#B3261E" TextWrapping="Wrap" Margin="0,0,0,8" />

                  <TextBlock Text="Redacted text" Foreground="#6B7580" FontSize="11" />
                  <TextBox Text="{Binding Text, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" MinHeight="90" MaxHeight="220"
                           VerticalScrollBarVisibility="Auto" Margin="0,2,0,10" />

                  <TextBlock Text="{Binding RedactionsText}" FontWeight="SemiBold" />
                  <TextBlock Text="Audit (category · tier · action)" Foreground="#6B7580" FontSize="11" Margin="0,8,0,2" />
                  <ItemsControl ItemsSource="{Binding AuditLines}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <TextBlock Text="{Binding}" FontFamily="Consolas" FontSize="12" />
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <TextBlock Visibility="{Binding NoAuditVisibility}" Text="(nothing flagged)" Foreground="#6B7580" FontSize="12" />
                </StackPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <Border x:Name="OcrPanel" Visibility="Collapsed" Margin="0,12,0,0" Padding="14" Background="White"
                BorderBrush="#E1E5EA" BorderThickness="1" CornerRadius="8" HorizontalAlignment="Left" Width="660">
          <StackPanel>
            <TextBlock Text="OCR text (what the filters were given)" FontWeight="SemiBold" />
            <TextBox x:Name="OcrBox" IsReadOnly="True" TextWrapping="Wrap" MaxHeight="160"
                     VerticalScrollBarVisibility="Auto" Margin="0,6,0,0" />
          </StackPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>
  </Grid>
</UserControl>
