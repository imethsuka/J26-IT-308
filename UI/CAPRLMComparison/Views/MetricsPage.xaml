<UserControl x:Class="CAPRLMComparison.Views.MetricsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:sp="clr-namespace:ScottPlot.WPF;assembly=ScottPlot.WPF"
             FontFamily="Segoe UI" FontSize="13">
  <Grid Margin="12">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <!-- Dataset banner: shown for every result, and loud for a placeholder. It is the first thing on the page. -->
    <Border Grid.Row="0" x:Name="DatasetBanner" CornerRadius="8" Padding="16,12" Visibility="Collapsed">
      <DockPanel>
        <ui:Button DockPanel.Dock="Right" Content="Refresh" Click="OnRefresh" VerticalAlignment="Top" />
        <StackPanel>
          <TextBlock x:Name="DatasetTitle" FontSize="16" FontWeight="Bold" TextWrapping="Wrap" />
          <TextBlock x:Name="DatasetWarning" TextWrapping="Wrap" Margin="0,4,0,0" />
          <TextBlock x:Name="DatasetMeta" TextWrapping="Wrap" Margin="0,8,0,0" FontSize="12" />
        </StackPanel>
      </DockPanel>
    </Border>

    <!-- Error / loading: always explicit, never a blank page. -->
    <Border Grid.Row="1" x:Name="StatusBanner" CornerRadius="6" Padding="12,8" Margin="0,0,0,0" Visibility="Collapsed">
      <DockPanel>
        <ui:Button x:Name="RetryButton" DockPanel.Dock="Right" Content="Retry" Click="OnRefresh" Margin="12,0,0,0" />
        <TextBlock x:Name="StatusText" TextWrapping="Wrap" VerticalAlignment="Center" />
      </DockPanel>
    </Border>

    <ScrollViewer Grid.Row="2" Margin="0,12,0,0" VerticalScrollBarVisibility="Auto">
      <StackPanel>
        <UniformGrid x:Name="ChartGrid" Columns="3" Visibility="Collapsed" />
        <Border x:Name="NotesPanel" Visibility="Collapsed" Margin="0,12,0,0" Padding="14" Background="White"
                BorderBrush="#E1E5EA" BorderThickness="1" CornerRadius="8">
          <StackPanel>
            <TextBlock Text="How to read these numbers" FontWeight="SemiBold" />
            <ItemsControl x:Name="NotesList" Margin="0,6,0,0">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding}" TextWrapping="Wrap" Foreground="#4B5563" Margin="0,2,0,2" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>
  </Grid>
</UserControl>
