<UserControl x:Class="CAPRLMComparison.Views.ReviewPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             FontFamily="Segoe UI" FontSize="13" Foreground="{StaticResource Ink}">
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <Grid Margin="32,24,32,16">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>

      <StackPanel Grid.Row="0" Margin="0,0,0,18">
        <TextBlock Text="Privacy Review" FontSize="24" FontWeight="SemiBold" />
        <TextBlock Text="Detect &amp; protect sensitive content before storage" Style="{StaticResource MutedText}" Margin="0,2,0,0" />
      </StackPanel>

      <!-- Always says what happened; never blank. -->
      <Border Grid.Row="1" x:Name="StatusBanner" CornerRadius="10" Padding="14,10" Margin="0,0,0,16" Visibility="Collapsed">
        <TextBlock x:Name="StatusText" TextWrapping="Wrap" />
      </Border>

      <Grid Grid.Row="2">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" MinWidth="380" />
          <ColumnDefinition Width="20" />
          <ColumnDefinition Width="380" />
        </Grid.ColumnDefinitions>

        <!-- ============ left: capture, result, outbound ============ -->
        <StackPanel Grid.Column="0">

          <Border Style="{StaticResource Card}">
            <StackPanel>
              <TextBlock Text="Capture to review" Style="{StaticResource CardTitle}" />
              <TextBlock Text="Paste text the way the collector would hand it over, with the context it came from."
                         Style="{StaticResource MutedText}" Margin="0,2,0,12" />
              <TextBox x:Name="InputText" AcceptsReturn="True" TextWrapping="Wrap" Height="150"
                       VerticalScrollBarVisibility="Auto" FontFamily="Consolas" />
              <Grid Margin="0,10,0,0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" /><ColumnDefinition Width="8" />
                  <ColumnDefinition Width="*" /><ColumnDefinition Width="8" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <ui:TextBox Grid.Column="0" x:Name="AppBox" PlaceholderText="App" Text="outlook" />
                <ui:TextBox Grid.Column="2" x:Name="DomainBox" PlaceholderText="Domain (optional)" Text="mail.example.com" />
                <ui:TextBox Grid.Column="4" x:Name="TitleBox" PlaceholderText="Window title" Text="Inbox" />
              </Grid>
              <ui:Button x:Name="AnalyzeButton" Content="Analyze capture" Appearance="Primary" Click="OnAnalyze"
                         Margin="0,12,0,0" HorizontalAlignment="Left" />
            </StackPanel>
          </Border>

          <Border Style="{StaticResource Card}" x:Name="ResultCard" Visibility="Collapsed">
            <StackPanel>
              <DockPanel>
                <StackPanel DockPanel.Dock="Right" HorizontalAlignment="Right">
                  <TextBlock Text="RESIDUAL RISK" FontSize="10" FontFamily="Consolas" Foreground="{StaticResource Muted}"
                             HorizontalAlignment="Right" />
                  <TextBlock x:Name="ResidualText" FontSize="26" FontWeight="SemiBold" HorizontalAlignment="Right" />
                </StackPanel>
                <StackPanel>
                  <TextBlock Text="Captured context" Style="{StaticResource CardTitle}" />
                  <TextBlock x:Name="ResultSubtitle" Style="{StaticResource MutedText}" Margin="0,2,0,0" />
                </StackPanel>
              </DockPanel>
              <ProgressBar x:Name="ResidualBar" Minimum="0" Maximum="100" Height="6" Margin="0,12,0,14"
                           Background="{StaticResource Track}" BorderThickness="0" />
              <Border Style="{StaticResource Inset}">
                <TextBlock x:Name="RedactedBlock" Style="{StaticResource MonoText}" />
              </Border>
            </StackPanel>
          </Border>

          <Border Style="{StaticResource Card}" x:Name="OutboundCard" Visibility="Collapsed">
            <StackPanel>
              <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                  <TextBlock Text="mask before send" FontFamily="Consolas" FontSize="11"
                             Foreground="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,8,0" />
                  <ui:ToggleSwitch x:Name="MaskBeforeSend" Click="OnMaskBeforeSend" />
                </StackPanel>
                <StackPanel>
                  <TextBlock Text="Sent to connected LLM API" Style="{StaticResource CardTitle}" />
                  <TextBlock x:Name="OutboundSubtitle" Style="{StaticResource MutedText}" Margin="0,2,0,0" />
                </StackPanel>
              </DockPanel>
              <Border x:Name="OutboundBanner" CornerRadius="8" Padding="12,9" Margin="0,12,0,12">
                <TextBlock x:Name="OutboundBannerText" TextWrapping="Wrap" FontSize="12" />
              </Border>
              <TextBlock Text="outbound payload" FontFamily="Consolas" FontSize="11"
                         Foreground="{StaticResource Muted}" Margin="2,0,0,6" />
              <Border Style="{StaticResource Inset}">
                <TextBlock x:Name="OutboundBlock" Style="{StaticResource MonoText}" />
              </Border>
              <TextBlock Text="Preview only: nothing is transmitted from this screen. The payload shown is what the connector would send."
                         Style="{StaticResource MutedText}" Margin="2,10,0,0" />
            </StackPanel>
          </Border>
        </StackPanel>

        <!-- ============ right: level, entities, profile ============ -->
        <StackPanel Grid.Column="2">

          <Border Style="{StaticResource Card}">
            <StackPanel>
              <DockPanel>
                <Border DockPanel.Dock="Right" Style="{StaticResource Chip}" Background="{StaticResource InsetBg}">
                  <TextBlock x:Name="TauChip" Text="τ —" FontFamily="Consolas" FontSize="11" Foreground="{StaticResource Muted}" />
                </Border>
                <TextBlock Text="Protection level" Style="{StaticResource CardTitle}" />
              </DockPanel>
              <TextBlock Text="How aggressively entities are masked by default. You can still correct any single entity below."
                         Style="{StaticResource MutedText}" Margin="0,4,0,12" />
              <UniformGrid Columns="3">
                <RadioButton x:Name="LevelRelaxed" GroupName="Level" Tag="relaxed" Style="{StaticResource LevelCard}" Checked="OnLevelChecked">
                  <StackPanel>
                    <TextBlock Text="Relaxed" FontWeight="SemiBold" />
                    <TextBlock Text="mask only high-risk" FontSize="10" FontFamily="Consolas" Foreground="{StaticResource Muted}" TextWrapping="Wrap" />
                  </StackPanel>
                </RadioButton>
                <RadioButton x:Name="LevelBalanced" GroupName="Level" Tag="balanced" Style="{StaticResource LevelCard}" Checked="OnLevelChecked">
                  <StackPanel>
                    <TextBlock Text="Balanced" FontWeight="SemiBold" />
                    <TextBlock Text="recommended default" FontSize="10" FontFamily="Consolas" Foreground="{StaticResource Muted}" TextWrapping="Wrap" />
                  </StackPanel>
                </RadioButton>
                <RadioButton x:Name="LevelStrict" GroupName="Level" Tag="strict" Style="{StaticResource LevelCard}" Margin="0" Checked="OnLevelChecked">
                  <StackPanel>
                    <TextBlock Text="Strict" FontWeight="SemiBold" />
                    <TextBlock Text="mask most entities" FontSize="10" FontFamily="Consolas" Foreground="{StaticResource Muted}" TextWrapping="Wrap" />
                  </StackPanel>
                </RadioButton>
              </UniformGrid>
            </StackPanel>
          </Border>

          <Border Style="{StaticResource Card}">
            <StackPanel>
              <DockPanel>
                <Border DockPanel.Dock="Right" Style="{StaticResource Chip}" Background="{StaticResource PurpleSoft}">
                  <TextBlock x:Name="MaskedChip" Text="—" FontFamily="Consolas" FontSize="11" Foreground="{StaticResource Purple}" />
                </Border>
                <TextBlock Text="Detected entities" Style="{StaticResource CardTitle}" />
              </DockPanel>
              <TextBlock Text="Auto-detected. Correct any to teach your profile." Style="{StaticResource MutedText}" Margin="0,4,0,8" />
              <TextBlock x:Name="NoEntities" Text="Analyze a capture to see what was detected." Style="{StaticResource MutedText}" Margin="0,8,0,4" />
              <ItemsControl x:Name="EntityList">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border BorderBrush="{StaticResource CardBorder}" BorderThickness="0,1,0,0" Padding="0,12">
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,10,0">
                          <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Category}" FontFamily="Consolas" FontSize="11" Foreground="{StaticResource Purple}" />
                            <Ellipse Width="7" Height="7" Margin="7,1,5,0" Fill="{Binding RiskBrush}" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding RiskText}" FontFamily="Consolas" FontSize="11" Foreground="{StaticResource Muted}" />
                          </StackPanel>
                          <TextBlock Text="{Binding Display}" FontFamily="Consolas" FontSize="14" Margin="0,3,0,2"
                                     TextWrapping="Wrap" Foreground="{Binding DisplayBrush}" />
                          <TextBlock Text="{Binding Reason}" Style="{StaticResource MutedText}" FontSize="11" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Center">
                          <ui:ToggleSwitch IsChecked="{Binding IsMasked, Mode=OneWay}" Tag="{Binding Id}" Click="OnEntityToggled" />
                          <TextBlock Text="{Binding StateText}" FontFamily="Consolas" FontSize="10"
                                     Foreground="{StaticResource Muted}" HorizontalAlignment="Center" />
                        </StackPanel>
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>

          <Border Style="{StaticResource Card}">
            <StackPanel>
              <DockPanel>
                <Border DockPanel.Dock="Right" Style="{StaticResource Chip}" Background="{StaticResource GreenSoft}">
                  <TextBlock x:Name="LearnedChip" Text="0 learned" FontFamily="Consolas" FontSize="11" Foreground="{StaticResource Green}" />
                </Border>
                <TextBlock Text="Your privacy profile" Style="{StaticResource CardTitle}" />
              </DockPanel>
              <TextBlock Text="What CAPRLM has learned from your corrections." Style="{StaticResource MutedText}" Margin="0,4,0,8" />
              <TextBlock x:Name="ProfileText" Style="{StaticResource MutedText}" />
              <ui:Button x:Name="ResetProfileButton" Content="Reset profile" Click="OnResetProfile" Margin="0,10,0,0"
                         Visibility="Collapsed" />
            </StackPanel>
          </Border>
        </StackPanel>
      </Grid>
    </Grid>
  </ScrollViewer>
</UserControl>

